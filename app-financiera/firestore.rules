rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Propietario de la app: la UNICA cuenta que puede dar o quitar el rol de
    // administrador. Pon aqui tu UID de Firebase Auth (lo ves en Gestion >
    // Acceso de administrador). Mientras sea el valor de ejemplo, cualquier
    // administrador puede nombrar administradores (comportamiento anterior).
    function propietarioUid() {
      return 'PON-AQUI-TU-UID';
    }
    function hayPropietario() {
      return propietarioUid() != 'PON-AQUI-TU-UID';
    }
    function esPropietario() {
      return isSignedIn() && request.auth.uid == propietarioUid();
    }

    // isAdmin se lee del documento del propio usuario. Es fiable PORQUE las
    // reglas de abajo impiden que el cliente escriba ese campo. El propietario
    // es administrador siempre, tenga o no el campo.
    function isAdmin() {
      return esPropietario()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Campos de privilegio, de suscripcion, de Stripe y de bloqueo: el cliente
    // NUNCA los modifica (los escriben el admin o las Cloud Functions de Stripe).
    function camposProtegidos() {
      return ['isAdmin', 'permissions', 'trialEndsAt', 'plan', 'paidUntil', 'bloqueado',
              'stripeCustomerId', 'stripeSubscriptionId', 'stripeStatus', 'cancelAtPeriodEnd'];
    }
    function noTocaCamposProtegidos() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposProtegidos());
    }
    // Cambiar el rol de administrador: solo el propietario (si esta configurado).
    function cambiaRolAdmin() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']);
    }

    // Nunca se admite un campo password en la base de datos.
    function sinPassword() {
      return !request.resource.data.keys().hasAny(['password']);
    }

    // 15 dias en milisegundos.
    function duracionPrueba() {
      return 1296000000;
    }

    // El cliente calcula trialEndsAt con SU reloj, que puede ir adelantado
    // respecto al del servidor. Sin holgura, un reloj un minuto adelantado
    // hacia que Firestore rechazara el alta entera y el usuario no pudiera
    // registrarse. Un dia de tolerancia: no permite abusos reales y evita
    // dejar gente fuera por un reloj mal puesto.
    function toleranciaReloj() {
      return 86400000;
    }

    // Prueba vigente o suscripcion pagada, y cuenta no bloqueada por el admin.
    // Las fechas se guardan en milisegundos (Date.now()), igual que el resto
    // de marcas de tiempo de la app.
    function suscripcionActiva(userId) {
      let perfil = get(/databases/$(database)/documents/users/$(userId)).data;
      return perfil.get('bloqueado', false) != true
          && (perfil.get('paidUntil', 0) > request.time.toMillis()
              || perfil.get('trialEndsAt', 0) > request.time.toMillis());
    }

    // Los documentos de actividad se llaman session_<uid>_<fecha>.
    function esSuRegistroDeActividad(logId) {
      return isSignedIn() && logId.matches('session_' + request.auth.uid + '(_.*)?');
    }

    // ─── PERFILES DE USUARIO ──────────────────────────────────────────────────
    match /users/{userId} {
      // Solo el dueño lee su perfil, y el admin para el panel de gestion.
      allow read: if isOwner(userId) || isAdmin();

      // Alta: solo tu propio perfil, sin password, sin autoconcederte admin,
      // sin fijarte tu el estado de pago ni el bloqueo, y con la prueba
      // acotada a 15 dias.
      allow create: if isOwner(userId)
                    && sinPassword()
                    && (!request.resource.data.keys().hasAny(['isAdmin'])
                        || request.resource.data.isAdmin == false)
                    && !request.resource.data.keys().hasAny(['plan', 'paidUntil', 'bloqueado',
                                                             'stripeCustomerId', 'stripeSubscriptionId', 'stripeStatus', 'cancelAtPeriodEnd'])
                    // Los permisos iniciales son los basicos: nadie se concede el
                    // panel de gestion al darse de alta.
                    && (!request.resource.data.keys().hasAny(['permissions'])
                        || !request.resource.data.permissions.hasAny(['users']))
                    && (!request.resource.data.keys().hasAny(['trialEndsAt'])
                        || request.resource.data.trialEndsAt <= request.time.toMillis() + duracionPrueba() + toleranciaReloj());

      // Edicion: el dueño no puede introducir password ni escalar privilegios
      // ni prolongarse la prueba ni desbloquearse. El admin si (ahi se marca
      // el pago recibido o el bloqueo), pero solo el propietario puede dar o
      // quitar el rol de administrador cuando propietarioUid() esta configurado.
      allow update: if (isAdmin() && (!cambiaRolAdmin() || !hayPropietario() || esPropietario()))
                    || (isOwner(userId) && sinPassword() && noTocaCamposProtegidos());

      allow delete: if isAdmin();

      // ─── DATOS FINANCIEROS (data, settings, loans...) ───────────────────────
      // Solo SUBCOLECCIONES del perfil: se exige al menos un segmento
      // ({coleccion}). Con `match /{documento=**}` a secas, en rules_version 2
      // el comodin recursivo tambien casa con cero segmentos, es decir, con el
      // propio documento /users/{userId}; como Firestore concede el acceso si
      // CUALQUIER regla lo permite, el `allow write` de abajo (que solo mira la
      // suscripcion) dejaba al dueño escribir isAdmin, paidUntil o bloqueado en
      // su perfil saltandose noTocaCamposProtegidos().
      match /{coleccion}/{documento=**} {
        // LECTURA siempre para el dueño, tambien con la prueba caducada o la
        // cuenta bloqueada: el derecho de acceso del RGPD no se puede
        // condicionar al pago.
        allow read: if isOwner(userId) || isAdmin();

        // ESCRITURA solo con prueba vigente o suscripcion pagada, y sin bloqueo.
        allow write: if isAdmin()
                     || (isOwner(userId) && suscripcionActiva(userId));
      }
    }

    // ─── REGISTRO DE ACTIVIDAD ────────────────────────────────────────────────
    match /activity_logs/{logId} {
      // El admin ve todo. Cada usuario puede leer SOLO sus propios documentos
      // (la app comprueba si existe el del dia para estampar la hora de inicio).
      allow read: if isAdmin() || esSuRegistroDeActividad(logId);
      // Crear y actualizar: solo documentos propios, y siempre con el uid propio.
      // Antes cualquier usuario podia sobrescribir el registro de otro.
      allow create: if esSuRegistroDeActividad(logId)
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
                    || (esSuRegistroDeActividad(logId)
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── ERRORES DE SISTEMA ───────────────────────────────────────────────────
    match /system_errors/{errorId} {
      allow read: if isAdmin();
      // Solo se admiten los campos que escribe la app, con el uid propio y un
      // mensaje acotado, para que nadie use la coleccion como almacen.
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['context', 'error', 'timestamp', 'uid'])
                    && request.resource.data.error is string
                    && request.resource.data.error.size() <= 2000;
      allow update, delete: if isAdmin();
    }

    // ─── EVENTOS DE STRIPE (los escribe la Cloud Function del webhook) ──────────
    match /eventos_stripe/{eventoId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── TODO LO DEMAS: DENEGADO ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
