rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Propietario de la app: la UNICA cuenta que puede dar o quitar el rol de
    // administrador. Pon aqui tu UID de Firebase Auth (lo ves en Gestion >
    // Acceso de administrador). Mientras sea el valor de ejemplo, cualquier
    // administrador puede nombrar administradores (comportamiento anterior).
    function propietarioUid() {
      return 'PON-AQUI-TU-UID';
    }
    function hayPropietario() {
      return propietarioUid() != 'PON-AQUI-TU-UID';
    }
    function esPropietario() {
      return isSignedIn() && request.auth.uid == propietarioUid();
    }

    // isAdmin se lee del documento del propio usuario. Es fiable PORQUE las
    // reglas de abajo impiden que el cliente escriba ese campo. El propietario
    // es administrador siempre, tenga o no el campo.
    function isAdmin() {
      return esPropietario()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Campos de privilegio, de suscripcion, de Stripe, de bloqueo y de rol
    // (invitado, excepciones de secciones): el cliente NUNCA los modifica (los
    // escriben el admin o las Cloud Functions de Stripe).
    function camposProtegidos() {
      return ['isAdmin', 'permissions', 'trialEndsAt', 'plan', 'paidUntil', 'bloqueado',
              'stripeCustomerId', 'stripeSubscriptionId', 'stripeStatus', 'cancelAtPeriodEnd',
              'invitado', 'invitadoHasta', 'vistasExtra', 'vistasQuitadas', 'creado'];
    }
    function noTocaCamposProtegidos() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposProtegidos());
    }
    // Cambiar el rol de administrador: solo el propietario (si esta configurado).
    function cambiaRolAdmin() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']);
    }

    // Nunca se admite un campo password en la base de datos.
    function sinPassword() {
      return !request.resource.data.keys().hasAny(['password']);
    }

    // Ajustes de acceso que edita el administrador (Gestion > Roles y permisos):
    // dias de prueba y, por rol, si puede escribir. Si el documento no existe
    // valen los valores por defecto (15 dias; escriben todos menos 'caducado').
    function hayAjustesAcceso() {
      return exists(/databases/$(database)/documents/ajustes/acceso);
    }
    function ajustesAcceso() {
      return get(/databases/$(database)/documents/ajustes/acceso).data;
    }
    function diasPrueba() {
      return hayAjustesAcceso() ? ajustesAcceso().get('diasPrueba', 15) : 15;
    }
    // Duracion de la prueba en milisegundos.
    function duracionPrueba() {
      return diasPrueba() * 86400000;
    }

    // Rol efectivo de un perfil. Mismo orden que rolEfectivo() en src/acceso.js.
    function rolDe(perfil) {
      return perfil.get('bloqueado', false) == true ? 'bloqueado'
        : (perfil.get('paidUntil', 0) > request.time.toMillis() ? 'pago'
        : ((perfil.get('invitado', false) == true
            && (perfil.get('invitadoHasta', 0) == 0 || perfil.get('invitadoHasta', 0) > request.time.toMillis())) ? 'invitado'
        : (perfil.get('trialEndsAt', 0) > request.time.toMillis() ? 'prueba' : 'caducado')));
    }
    // Si ese rol puede editar sus datos segun los ajustes del administrador.
    function rolPuedeEscribir(rol) {
      return rol != 'bloqueado'
        && (hayAjustesAcceso()
            ? ajustesAcceso().get(['roles', rol, 'escribir'], rol != 'caducado') == true
            : rol != 'caducado');
    }

    // Correo de la cuenta autenticada, en minusculas ('' si no lo hay).
    function emailSesion() {
      return request.auth.token.get('email', '').lower();
    }
    // Una invitacion del administrador (invitaciones/{correo}) permite darse de
    // alta ya como invitado, con la misma fecha limite que fijo el admin.
    function invitacionValida() {
      return emailSesion() != ''
        && exists(/databases/$(database)/documents/invitaciones/$(emailSesion()))
        && request.resource.data.get('invitadoHasta', 0)
           == get(/databases/$(database)/documents/invitaciones/$(emailSesion())).data.get('hasta', 0);
    }

    // El cliente calcula trialEndsAt con SU reloj, que puede ir adelantado
    // respecto al del servidor. Sin holgura, un reloj un minuto adelantado
    // hacia que Firestore rechazara el alta entera y el usuario no pudiera
    // registrarse. Un dia de tolerancia: no permite abusos reales y evita
    // dejar gente fuera por un reloj mal puesto.
    function toleranciaReloj() {
      return 86400000;
    }

    // Correo verificado (las cuentas de Google lo traen verificado). Las
    // cuentas anteriores a la verificacion obligatoria no tienen el campo
    // `creado` y quedan exentas; el cliente no puede escribir ese campo.
    function correoVerificado() {
      return request.auth.token.get('email_verified', false) == true;
    }
    function verificacionOk(perfil) {
      return correoVerificado() || perfil.get('creado', 0) == 0;
    }

    // Puede escribir sus datos: correo verificado (cuentas nuevas) y, segun su
    // rol (prueba vigente, pagado, invitado o prueba terminada), lo que el
    // administrador haya configurado para ese rol; nunca si esta bloqueado.
    // Las fechas se guardan en milisegundos (Date.now()), igual que el resto
    // de marcas de tiempo de la app.
    function suscripcionActiva(userId) {
      let perfil = get(/databases/$(database)/documents/users/$(userId)).data;
      return verificacionOk(perfil) && rolPuedeEscribir(rolDe(perfil));
    }

    // Los documentos de actividad se llaman session_<uid>_<fecha>.
    function esSuRegistroDeActividad(logId) {
      return isSignedIn() && logId.matches('session_' + request.auth.uid + '(_.*)?');
    }

    // ─── PERFILES DE USUARIO ──────────────────────────────────────────────────
    match /users/{userId} {
      // Solo el dueño lee su perfil, y el admin para el panel de gestion.
      allow read: if isOwner(userId) || isAdmin();

      // Alta: solo tu propio perfil, sin password, sin autoconcederte admin,
      // sin fijarte tu el estado de pago ni el bloqueo, con la prueba acotada
      // a los dias configurados y como invitado solo si el admin te invito.
      allow create: if isOwner(userId)
                    && sinPassword()
                    && (!request.resource.data.keys().hasAny(['isAdmin'])
                        || request.resource.data.isAdmin == false)
                    && !request.resource.data.keys().hasAny(['plan', 'paidUntil', 'bloqueado',
                                                             'stripeCustomerId', 'stripeSubscriptionId', 'stripeStatus', 'cancelAtPeriodEnd',
                                                             'vistasExtra', 'vistasQuitadas'])
                    && (!request.resource.data.keys().hasAny(['invitado', 'invitadoHasta'])
                        || (request.resource.data.get('invitado', false) == true && invitacionValida()))
                    // Fecha de alta obligatoria y real (con tolerancia de reloj):
                    // sin ella una cuenta nueva se saltaria la verificacion del correo.
                    && request.resource.data.get('creado', 0) is int
                    && request.resource.data.get('creado', 0) >= request.time.toMillis() - toleranciaReloj()
                    && request.resource.data.get('creado', 0) <= request.time.toMillis() + toleranciaReloj()
                    // Los permisos iniciales son los basicos: nadie se concede el
                    // panel de gestion al darse de alta.
                    && (!request.resource.data.keys().hasAny(['permissions'])
                        || !request.resource.data.permissions.hasAny(['users']))
                    && (!request.resource.data.keys().hasAny(['trialEndsAt'])
                        || request.resource.data.trialEndsAt <= request.time.toMillis() + duracionPrueba() + toleranciaReloj());

      // Edicion: el dueño no puede introducir password ni escalar privilegios
      // ni prolongarse la prueba ni desbloquearse. El admin si (ahi se marca
      // el pago recibido o el bloqueo), pero solo el propietario puede dar o
      // quitar el rol de administrador cuando propietarioUid() esta configurado.
      allow update: if (isAdmin() && (!cambiaRolAdmin() || !hayPropietario() || esPropietario()))
                    || (isOwner(userId) && sinPassword() && noTocaCamposProtegidos());

      allow delete: if isAdmin();

      // ─── DATOS FINANCIEROS (data, settings, loans...) ───────────────────────
      // Solo SUBCOLECCIONES del perfil: se exige al menos un segmento
      // ({coleccion}). Con `match /{documento=**}` a secas, en rules_version 2
      // el comodin recursivo tambien casa con cero segmentos, es decir, con el
      // propio documento /users/{userId}; como Firestore concede el acceso si
      // CUALQUIER regla lo permite, el `allow write` de abajo (que solo mira la
      // suscripcion) dejaba al dueño escribir isAdmin, paidUntil o bloqueado en
      // su perfil saltandose noTocaCamposProtegidos().
      match /{coleccion}/{documento=**} {
        // LECTURA siempre para el dueño, tambien con la prueba caducada o la
        // cuenta bloqueada: el derecho de acceso del RGPD no se puede
        // condicionar al pago.
        allow read: if isOwner(userId) || isAdmin();

        // ESCRITURA solo con prueba vigente o suscripcion pagada, y sin bloqueo.
        allow write: if isAdmin()
                     || (isOwner(userId) && suscripcionActiva(userId));
      }
    }

    // ─── REGISTRO DE ACTIVIDAD ────────────────────────────────────────────────
    match /activity_logs/{logId} {
      // El admin ve todo. Cada usuario puede leer SOLO sus propios documentos
      // (la app comprueba si existe el del dia para estampar la hora de inicio).
      allow read: if isAdmin() || esSuRegistroDeActividad(logId);
      // Crear y actualizar: solo documentos propios, y siempre con el uid propio.
      // Antes cualquier usuario podia sobrescribir el registro de otro.
      allow create: if esSuRegistroDeActividad(logId)
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
                    || (esSuRegistroDeActividad(logId)
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── ERRORES DE SISTEMA ───────────────────────────────────────────────────
    match /system_errors/{errorId} {
      allow read: if isAdmin();
      // Solo se admiten los campos que escribe la app, con el uid propio y un
      // mensaje acotado, para que nadie use la coleccion como almacen.
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['context', 'error', 'timestamp', 'uid'])
                    && request.resource.data.error is string
                    && request.resource.data.error.size() <= 2000;
      allow update, delete: if isAdmin();
    }

    // ─── EVENTOS DE STRIPE (los escribe la Cloud Function del webhook) ──────────
    match /eventos_stripe/{eventoId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── AJUSTES DE ACCESO (Gestion > Roles y permisos) ───────────────────────
    // Cualquier usuario identificado los lee (la app decide que secciones
    // mostrar y cuantos dias de prueba dar al registrarse); solo el admin los
    // escribe, y con forma valida.
    match /ajustes/acceso {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
                            && request.resource.data.diasPrueba is int
                            && request.resource.data.diasPrueba >= 1
                            && request.resource.data.diasPrueba <= 365
                            && request.resource.data.roles is map;
      allow delete: if isAdmin();
    }

    // Lanzamiento de los pagos (Gestion > Stripe): abiertos a todos o solo a
    // los probadores. La app lo lee para mostrar el boton; la funcion de pago
    // lo vuelve a comprobar en el servidor.
    match /ajustes/pagos {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
                            && request.resource.data.abierto is bool
                            && request.resource.data.probadores is list
                            && request.resource.data.probadores.size() <= 50;
      allow delete: if isAdmin();
    }

    // ─── INVITACIONES (cuentas gratuitas) ─────────────────────────────────────
    // El documento se llama como el correo invitado, en minusculas. Solo lo
    // leen el admin y la propia persona invitada (al registrarse).
    match /invitaciones/{email} {
      allow read: if isAdmin() || (isSignedIn() && emailSesion() == email);
      allow write: if isAdmin();
    }

    // ─── TODO LO DEMAS: DENEGADO ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
