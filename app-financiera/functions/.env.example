# Copia este fichero a functions/.env y rellena los valores (no son secretos:
# las claves de Stripe van en secretos de Firebase, ver STRIPE.md).
STRIPE_PRICE_ID=price_XXXXXXXXXXXXXXXX
# Dominio desde el que se usa la app (Stripe vuelve aquí tras el pago).
# El hosting responde en finanziapp.com, finanzas.franquizb.com y personal-franquizb.web.app.
APP_URL=https://finanziapp.com
