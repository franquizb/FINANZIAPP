# Modo demo para capturas de marketing (ver marketing/instagram/README.md).
# En 0 el compilador elimina la ruta /demo del build de producción; para
# generar capturas se construye con REACT_APP_DEMO=1 en el entorno.
REACT_APP_DEMO=0

# No publicar los mapas de código fuente (el código legible con comentarios).
GENERATE_SOURCEMAP=false
